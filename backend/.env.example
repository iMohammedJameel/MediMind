# Server
NODE_ENV=development
PORT=8080
LOG_LEVEL=info
FRONTEND_URL=http://localhost:3000

# Databases
MONGO_URI=mongodb://localhost:27017/medimind
REDIS_URL=redis://localhost:6379

# Authentication & PHI Encryption (replace with strong random secrets)
JWT_ACCESS_SECRET=replace_with_64_char_hex_access_secret
JWT_REFRESH_SECRET=replace_with_64_char_hex_refresh_secret
COOKIE_SECRET=replace_with_32_char_cookie_secret
ENCRYPTION_KEY_AES256=replace_with_64_char_hex_aes256_key

# Scheduler & OCR Microservice
ENABLE_SCHEDULER=true
OCR_SERVICE_URL=http://localhost:8000

# Optional Push / Email / SMS / S3 Integrations
# FCM_PROJECT_ID=
# FCM_CLIENT_EMAIL=
# FCM_PRIVATE_KEY=
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET_NAME=
# AWS_SES_FROM_EMAIL=no-reply@medimind.example
# AWS_SNS_SENDER_ID=MEDIMIND
# VAPID_SUBJECT=mailto:admin@medimind.example
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
